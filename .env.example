# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyverse?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudyVerse"

# ─── AI Doubt Solver ─────────────────────────────────────────
# Your DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Model to use. Defaults to "deepseek-chat".
# For DeepSeek V4 Flash, set: DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-chat
