# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyverse?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudyVerse"

# ─── AI Doubt Solver ─────────────────────────────────────────
# Your OpenRouter API key (https://openrouter.ai/keys)
DEEPSEEK_API_KEY=sk-or-v1-your-openrouter-api-key

# Model slug to use. Free-tier OpenRouter keys can ONLY use ":free" models.
# DeepSeek free models were removed by OpenRouter, so we default to a free
# Google model. Change this to any available ":free" slug if you prefer.
DEEPSEEK_MODEL=google/gemma-4-26b-a4b-it:free
